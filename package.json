{
  "name": "hostel-pro2",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3005",
    "build": "next build",
    "start": "next start -p 3005",
    "typecheck": "bunx tsc --noEmit",
    "lint": "bunx eslint src/",
    "test:unit": "bunx vitest run --config vitest.config.ts",
    "test:integration": "bunx vitest run --config vitest.integration.config.ts",
    "test:e2e": "bunx playwright test",
    "test:all": "bun run test:unit && bun run test:integration && bun run test:e2e",
    "test:coverage": "bunx vitest run --coverage",
    "phase:gate": "bash scripts/phase-gate.sh",
    "hooks:install": "bash scripts/install-hooks.sh",
    "db:generate": "bunx drizzle-kit generate",
    "db:push": "bunx drizzle-kit push",
    "db:studio": "bunx drizzle-kit studio"
  },
  "dependencies": {
    "better-auth": "^1.2.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.0",
    "lucide-react": "^0.562.0",
    "next": "^15.3.0",
    "next-intl": "^4.1.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.13.0",
    "postgres": "^3.4.5",
    "razorpay": "^2.9.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.34.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/bun": "^1.2.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "archiver": "^7.0.0",
    "drizzle-kit": "^0.30.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.3.0",
    "jsdom": "^25.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0",
    "@vitest/coverage-v8": "^4.0.0"
  }
}
