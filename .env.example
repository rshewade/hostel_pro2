# Database
DATABASE_URL=postgresql://db_user1:YOUR_PASSWORD@localhost:5432/hostel_pro2
TEST_DATABASE_URL=postgresql://db_user1:YOUR_PASSWORD@localhost:5432/hostel_pro2_test

# Better Auth
BETTER_AUTH_SECRET=change-this-to-a-secure-random-string
BETTER_AUTH_URL=http://localhost:3005
EXTERNAL_URL=http://51.68.196.242:3005

# Encryption
ENCRYPTION_KEY=
HASH_SALT=change-this-to-a-secure-random-string

# Storage
UPLOAD_DIR=./uploads
SIGNED_URL_SECRET=change-this-to-a-secure-random-string

# Mock Modes (all default to mock for development)
SMS_MODE=mock
RAZORPAY_MODE=mock
NOTIFICATION_MODE=mock
EMAIL_PROVIDER=console
WHATSAPP_MODE=mock

# Razorpay (only needed when RAZORPAY_MODE=live)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Twilio (only needed when SMS_MODE=live)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# MSG91 (alternative to Twilio)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Email (only needed when EMAIL_PROVIDER != console)
EMAIL_FROM=noreply@hostelpro.local
RESEND_API_KEY=
SENDGRID_API_KEY=

# Cron
CRON_SECRET=change-this-to-a-secure-random-string

# Task Master AI (for MCP server)
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
